# Copy to .env. Never commit your real key or credentials.
# vertex = Gemini on Vertex AI using ADC; api_key = Gemini Developer API.
FIF_AUTH_MODE=vertex
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
FIF_MODEL=gemini-2.5-flash

# For FIF_AUTH_MODE=api_key, set GOOGLE_GENAI_USE_VERTEXAI=FALSE and add a key:
GOOGLE_API_KEY=
# ADC is required for GCP tools in BOTH modes. Prefer gcloud ADC or attached
# service accounts. Optionally set an existing credential file path:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/credentials.json

# Default: reads and BigQuery dry runs; proposed mutations are returned as previews.
FIF_ALLOW_WRITES=false
# Run dry-run-validated SELECT queries (can incur BigQuery charges).
FIF_EXECUTE_QUERIES=false
FIF_BQ_LOCATION=US
FIF_BQ_MAX_BYTES=1000000000
FIF_HTTP_TIMEOUT=45
FIF_MAX_RESPONSE_CHARS=40000
